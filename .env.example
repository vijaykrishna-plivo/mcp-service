# ---- ACI backend ----
ACI_URL=http://localhost:8000          # self-hosted ACI server
ACI_API_KEY=                           # printed by scripts/seed.sh
OWNER_ID=cx-tenant                     # linked_account_owner_id = the CX tenant id

# ---- MCP server ----
PORT=8100                              # SSE port the CX platform connects to
MCP_MODE=apps                          # apps (flat 188 tools) | unified (2 meta-tools)

# ---- api_key apps ----
CAL_API_KEY=                           # cal.com API key
SERPAPI_API_KEY=                       # serpapi.com API key

# ---- oauth2 apps ----
# Client credentials are NOT env vars here — they go into per-app secrets
# files consumed at seed time (see secrets/README.md):
#   secrets/<app>.secrets.json  →  {"AIPOLABS_<APP>_CLIENT_ID": "...", ...}
