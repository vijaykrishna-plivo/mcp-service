# ---- ACI MCP bridge wiring (the bridge is already running on :8101) ----
ACI_BRIDGE_URL=http://localhost:8101
ACI_APP=google_calendar          # bridge path segment -> ACI app (GOOGLE_CALENDAR)
ACI_OWNER_ID=cx-tenant           # = ACI linked_account_owner_id you linked the Google account under
BRIDGE_SECRET_KEY=aci-test-secret-2026   # must match the bridge's BRIDGE_SECRET_KEY

# ---- Voice providers ----
VOICE_MODE=realtime              # realtime (1 OpenAI key) | pipeline (deepgram+openai+elevenlabs)
OPENAI_API_KEY=                  # required for realtime, and for pipeline LLM
# OPENAI_REALTIME_VOICE=alloy
# pipeline mode also needs:
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=
# OPENAI_MODEL=gpt-4o

# ---- LiveKit server (only for `dev` / `connect` modes + the Agents Playground) ----
# NOT needed for `console` mode (talk via your laptop).
LIVEKIT_URL=                     # wss://<project>.livekit.cloud  OR  ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
