[
  {
    "name": "PLIVO__SEND_MESSAGE",
    "description": "Send an SMS/MMS message from a Plivo number",
    "tags": ["messaging", "sms", "create"],
    "visibility": "public",
    "active": true,
    "protocol": "rest",
    "protocol_data": {
      "method": "POST",
      "path": "/Message/",
      "server_url": "https://api.plivo.com/v1/Account/{auth_id}"
    },
    "parameters": {
      "type": "object",
      "required": ["body"],
      "visible": ["body"],
      "additionalProperties": false,
      "properties": {
        "body": {
          "type": "object",
          "description": "Request body",
          "required": ["src", "dst", "text"],
          "visible": ["src", "dst", "text", "type", "url"],
          "additionalProperties": false,
          "properties": {
            "src": { "type": "string", "description": "Sender id / Plivo number (E.164)" },
            "dst": { "type": "string", "description": "Destination number(s), '<' delimited for multiple" },
            "text": { "type": "string", "description": "Message body text" },
            "type": { "type": "string", "description": "Message type: sms or mms" },
            "url": { "type": "string", "description": "Callback URL for delivery status" }
          }
        }
      }
    }
  },
