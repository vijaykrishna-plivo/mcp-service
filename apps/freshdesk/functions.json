  {
    "name": "FRESHDESK__CREATE_TICKETS_TIME_ENTRIES",
    "description": "Create a Time Entry",
    "tags": [
      "Time Entries"
    ],
    "visibility": "public",
    "active": true,
    "protocol": "rest",
    "protocol_data": {
      "method": "POST",
      "path": "/tickets/{ticketID}/time_entries",
      "server_url": "https://{subdomain}.freshdesk.com/api/v2"
    },
    "parameters": {
      "type": "object",
      "required": [
        "path",
        "body"
      ],
      "visible": [
        "path",
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "object",
          "properties": {
            "ticketID": {
              "type": "integer",
              "description": "Provide ID"
            }
          },
          "required": [
            "ticketID"
          ],
          "visible": [
            "ticketID"
          ],
          "additionalProperties": false,
          "description": "Path parameters"
        },
        "body": {
          "type": "object",
          "properties": {
            "agent_id": {
              "type": "string",
              "description": "The agent to whom this time-entry is associated. One agent can have only one timer running. Everything else will be stopped if new timer is on for an agent"
            },
            "billable": {
              "type": "boolean",
              "description": "Set as true if the entry is billable. Default value is true"
            },
            "executed_at": {
              "type": "string",
              "description": "Time at which this time-entry id added/created"
            },
            "note": {
              "type": "string",
              "description": "Description on this time-entry"
            },
            "start_time": {
              "type": "string",
              "description": "The time at which the time-entry is added or the time of the last invoked \"start-timer\" action using a toggle"
            },
            "time_spent": {
              "type": "string",
              "description": "The number of hours (in hh:mm format). Used to set the total time_spent"
            },
            "timer_running": {
              "type": "boolean",
              "description": "Indicates if the timer is running"
            }
          },
          "required": [],
          "visible": [
            "agent_id",
            "billable",
            "executed_at",
            "note",
            "start_time",
            "time_spent",
            "timer_running"
          ],
          "additionalProperties": false,
          "description": "Request body"
        }
      }
    }
  }
